{
  "compilerOptions": {
    // ES2022 to match `packages/config/base.json`. The admin app now
    // type-checks `@portfolio/database` sources, which use BigInt literals
    // (UUIDv7 timestamp packing) — unavailable below ES2020.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // The auth modules use explicit `.ts` specifiers so Node can execute
    // them directly (via type stripping) in the test scripts, without a
    // build step. Turbopack resolves them identically. Same setup as
    // packages/database — see docs/DECISIONS.md.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
