{
  // ---------------------------------------------------------------------
  // Production Worker configuration for the ADMIN CMS.
  //
  // The same shape as apps/web/wrangler.jsonc — see the notes there for what
  // is shared. What is different here is the security posture:
  //
  //   * This Worker MUST sit behind Cloudflare Access. The application fails
  //     closed without it — `readAccessConfig()` denies everything when the
  //     two CF_ACCESS_* vars are missing, and `requireAdminIdentity()`
  //     verifies the `Cf-Access-Jwt-Assertion` header on every Server Action
  //     and protected route. Deploying without Access configured therefore
  //     yields a Worker that serves nothing but denials — annoying, but safe.
  //
  //   * Cloudflare can attach Access directly to a workers.dev Worker from
  //     the dashboard: Workers & Pages -> portfolio-admin -> Settings ->
  //     Domains & Routes -> workers.dev -> Enable Cloudflare Access. That,
  //     and creating the Access application/policy, are OWNER actions — no
  //     code or command in this repository performs them.
  //
  //   * The two vars below are PUBLIC configuration, not secrets: the team
  //     domain is a public hostname and the AUD tag is a public identifier.
  //     They are left unset here because their values belong to the owner's
  //     Access application, which does not exist yet. Set them in the
  //     dashboard (Settings -> Variables) or fill them in here once the
  //     Access application exists. No API token, Access client secret, or
  //     private key is used anywhere — verification is against Cloudflare's
  //     public JWKS.
  //
  //   * ADMIN_DEV_AUTH must never be set on this Worker. A production build
  //     ignores it by design, and its absence keeps that design honest.
  // ---------------------------------------------------------------------
  "$schema": "node_modules/wrangler/config-schema.json",

  // https://portfolio-admin.<account-subdomain>.workers.dev
  "name": "portfolio-admin",

  "main": ".open-next/worker.js",

  // Kept in lockstep with apps/web/wrangler.jsonc — same workerd, same date.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "workers_dev": true,

  // Preview URLs stay OFF, pinned here because a deploy re-enables them by
  // default when `workers_dev` is on — measured: the owner disabled them in
  // the dashboard and the next deploy silently flipped them back on. The
  // preview hostname (`*-<worker>.workers.dev`) is NOT covered by the Access
  // application on the production hostname; the admin app itself still fails
  // closed there, but an unauthenticated surface nobody asked for is not a
  // surface to keep.
  "preview_urls": false,

  // Dashboard-set plain-text vars survive deploys. Without this, `wrangler
  // deploy` DELETES any var not listed in this file — which is exactly where
  // the owner sets public configuration like CONTACT_NOTIFY_* and
  // CF_ACCESS_*, since their values are the owner's and not the repo's.
  // Secrets always survive; this flag is only about plain-text vars.
  "keep_vars": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Public configuration. The two CF_ACCESS_* values are set as dashboard
  // variables (they belong to the owner's Access application, not to this
  // repository) and survive deploys thanks to `keep_vars` above.
  //
  // SITE_ORIGIN is the public site's origin, used for exactly one
  // thing: the admin's tab icon, which points at the public site's stable
  // `/site-icon` URL so both tabs show whatever the CMS currently holds. It is
  // committed because it is public by definition — it is the address of the
  // site this CMS edits. Update it when the site moves to a custom domain.
  "vars": {
    "SITE_ORIGIN": "https://portfolio-web.harshitsaini.workers.dev"
  },

  // The same database the public site reads. The admin is the writer.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-cms",
      "database_id": "1e85ce4f-d5e4-44e4-b589-e00992bc0b60"
    }
  ],

  // The same bucket the public site serves from. The admin is the writer:
  // uploads, replacements and deletes all happen through this binding.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "portfolio-media"
    }
  ]
}
