# Environment variable names only — no real values or secrets.
#
# Phase 1A (Repository Foundation) does not require any environment
# variables to run apps/web or apps/admin locally. This file documents the
# variable names expected in later phases so the naming convention is
# established early. Copy to .env.local per app when a variable is
# actually needed and never commit real values.

# --- Reserved for future phases (not yet used by any code in this phase) ---

# Cloudflare D1 (database phase)
# DATABASE_URL=

# Cloudflare R2 (media storage phase)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Auth (admin authentication phase)
# AUTH_SECRET=
# AUTH_ADMIN_EMAIL=

# Contact form handling (future phase)
# CONTACT_NOTIFICATION_EMAIL=
