# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
dist/
build/

# Env files (never commit real secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
playwright-report/
test-results/
# Transient snapshot/console dumps written by the Playwright MCP server
.playwright-mcp/

# Turborepo (not used, ignored defensively)
.turbo/

# Next.js auto-generated per-app agent-rules files (regenerated by
# `next dev`/`next build` on every run — root CLAUDE.md is the source of
# truth for agent instructions in this repo, not these).
apps/*/AGENTS.md
apps/*/CLAUDE.md

# Wrangler / Cloudflare local state.
# `.wrangler/` holds the local D1 (miniflare) SQLite state and caches — it is
# disposable test data, never source of truth. `.dev.vars` holds local secret
# values and must never be committed.
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# OpenNext build output. `opennextjs-cloudflare build` regenerates it from
# `.next/`, so it is derived artefacts — the bundled Worker entry point and a
# copy of the static assets — not source.
.open-next/

# Misc
*.local
